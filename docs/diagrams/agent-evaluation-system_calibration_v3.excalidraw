      "seed": 735188463,
      "version": 5719,
      "versionNonce": 502046251,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794960782840,
      "created": 1792610315675,
      "link": null,
      "locked": false,
      "text": "Core Entities + APIs\n\nAPIs\n1. POST /submit\n2. GET /status/{id}\n3. GET /results/{id} (analytics)\n\nCore Entities\n\nTask\n1. taskId\n2. status (CREATED / CALIBRATING / ACCEPTED / REJECTED)\n3. current_version (max 3)\n4. image_uri\n5. validation\n6. labels (JSON)\n   -> pass / fail percentage chart\n7. description\n   -> taxonomy-quota scheduling (embeddings = FUTURE 3)\n\nJob\n1. jobId\n2. taskId\n3. type (generate / validate / rollout / analyze), status\n4. result_class (VALID_PASS / VALID_FAIL / INVALID_INFRA)\n5. traces_s3_uri\n6. trace_metrics (JSON)\n   {\n     \"llm_calls\": 12,\n     \"input_tokens\": 18500,\n     \"output_tokens\": 4200,\n     \"tool_calls\": [\n       {\n         \"tool\": \"terminal\",\n         \"input\": \"pytest\",\n         \"output\": \"2 failed, 3 passed\",\n         \"exit_code\": 1\n       }\n     ],\n     \"files_modified\": [\"parser.py\", \"tests.py\"],\n     \"duration_seconds\": 310\n   }\n7. inference_cost",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities + APIs\n\nAPIs\n1. POST /submit\n2. GET /status/{id}\n3. GET /results/{id} (analytics)\n\nCore Entities\n\nTask\n1. taskId\n2. status (CREATED / CALIBRATING / ACCEPTED / REJECTED)\n3. current_version (max 3)\n4. image_uri\n5. validation\n6. labels (JSON)\n   -> pass / fail percentage chart\n7. description\n   -> taxonomy-quota scheduling (embeddings = FUTURE 3)\n\nJob\n1. jobId\n2. taskId\n3. type (generate / validate / rollout / analyze), status\n4. result_class (VALID_PASS / VALID_FAIL / INVALID_INFRA)\n5. traces_s3_uri\n6. trace_metrics (JSON)\n   {\n     \"llm_calls\": 12,\n     \"input_tokens\": 18500,\n     \"output_tokens\": 4200,\n     \"tool_calls\": [\n       {\n         \"tool\": \"terminal\",\n         \"input\": \"pytest\",\n         \"output\": \"2 failed, 3 passed\",\n         \"exit_code\": 1\n       }\n     ],\n     \"files_modified\": [\"parser.py\", \"tests.py\"],\n     \"duration_seconds\": 310\n   }\n7. inference_cost",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "startBinding": null,
      "endBinding": null
    },
