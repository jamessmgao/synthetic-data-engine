# Copy to deploy/local.env (gitignored) and uncomment what you change; every app
# container of the local stack reads it. Unset = the code's default. (`make up-agent`
# writes SDE_AUTHOR_MODE=agent to deploy/make.env; a value here wins over it.)
# tests/deploy/test_compose_env.py fails if a setting the code reads is missing here.
# SDE_BUDGET_USD=
# SDE_DOCKER_SLOTS=
# SDE_AGENT_SLOTS=
# SDE_GENERATION_CONCURRENCY=
# SDE_AUTHOR_MODE=
# SDE_AUTHORING_IMAGE=
# SDE_AUTHORING_CPUS=
# SDE_AUTHORING_MEMORY_MB=
# SDE_AGENT_LEASE_TTL_S=
# SDE_MIN_FREE_MEMORY_PCT=
# SDE_MAX_CPU_LOAD_PCT=
# SDE_DOCKER_CLAIM_SPACING_S=
# SDE_SUSPECT_MAX_WAIT_S=
# SDE_LEASE_TTL_S=
# SDE_HEARTBEAT_S=
# SDE_POLL_S=
# SDE_RECONCILE_S=
# SDE_RETRY_BACKOFF_SEC=
# SDE_MAX_VERSIONS=
# SDE_AUTHORING_REASONING_EFFORT=
# SDE_DOCKER_REAL=
# SDE_AUTHORING_LLM_TIMEOUT_S=
# SDE_AUTHORING_MAX_TOKENS=
# SDE_SOLVER_LLM_TIMEOUT_S=
