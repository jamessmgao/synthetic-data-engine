[9.012201, "o", "\"\"\"Reading record model.\"\"\"\r\nfrom dataclasses import dataclass\r\nfrom datetime import datetime\r\n\r\n\r\nclass ReadingError(ValueError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass Reading:\r\n    sensor: str\r\n    timestamp: datetime\r\n    value: float\r\n\r\n\r\ndef from_dict(payload):\r\n    if not isinstance(payload, dict):\r\n        raise ReadingError(\"reading must be a JSON object\")\r\n    try:\r\n        return Reading(sensor=str(payload[\"sensor\"]),\r\n                       timestamp=datetime.fromisoformat(str(payload[\"timestamp\"])),\r\n                       value=float(payload[\"value\"]))\r\n    except KeyError as exc:\r\n        raise ReadingError(\"missing field: %s\" % exc) from None\r\n\r\n\r\ndef to_dict(reading):\r\n    return {\"sensor\": reading.sensor,\r\n            \"timestamp\": reading.timestamp.isoformat(),\r\n            \"value\": reading.value}\r\n"]
[9.012734, "o", "\r\n--- timeutil ---\r\n"]
[9.013459, "o", "\"\"\"Interval parsing and epoch-aligned bucketing helpers.\"\"\"\r\nimport re\r\nfrom datetime import datetime, timedelta\r\n\r\n_EPOCH = datetime(1970, 1, 1)\r\n_UNITS = {\"m\": 60, \"h\": 3600, \"d\": 86400}\r\n_PATTERN = re.compile(r\"^([1-9][0-9]*)([mhd])$\")\r\n\r\n\r\ndef interval_seconds(interval):\r\n    match = _PATTERN.match(str(interval))\r\n    if not match:\r\n        raise ValueError(\"invalid interval: %r\" % (interval,))\r\n    return int(match.group(1)) * _UNITS[match.group(2)]\r\n\r\n\r\ndef bucket_start(ts, seconds):\r\n    delta = ts - _EPOCH\r\n    offset = (delta // timedelta(seconds=seconds)) * seconds\r\n    return _EPOCH + timedelta(seconds=offset)\r\n"]
[9.013615, "o", "\r\n--- aggregate ---\r\n"]
[9.016888, "o", "\"\"\"Fixed-interval bucket aggregation over readings.\"\"\"\r\nfrom dataclasses import dataclass\r\n\r\nfrom . import timeutil\r\n\r\n\r\n@dataclass\r\nclass Bucket:\r\n    sensor: str\r\n    start: str\r\n    count: int\r\n    minimum: float\r\n    maximum: float\r\n    mean: float\r\n\r\n\r\ndef aggregate(readings, interval=\"1h\"):\r\n    seconds = timeutil.interval_seconds(interval)\r\n    for r in readings:\r\n        r.timestamp = timeutil.bucket_start(r.timestamp, seconds)\r\n    readings.sort(key=lambda r: (r.sensor, r.timestamp))\r\n    grouped = {}\r\n    for r in readings:\r\n        grouped.setdefault((r.sensor, r.timestamp), []).append(r.value)\r\n    buckets = []\r\n    for (sensor, start), values in grouped.items():\r\n        buckets.append(Bucket(sensor=sensor, start=start.isoformat(),\r\n                              count=len(values), minimum=min(values),\r\n                              maximum=max(values),\r\n                              mean=sum(values) / len(values)))\r\n    buckets.sort(key=lambda b: (b.sensor, b.start))\r\n    return buckets\r\n\r\n\r\ndef "]
[9.016979, "o", "bucket_to_dict(bucket):\r\n    return {\"sensor\": bucket.sensor, \"start\": bucket.start,\r\n            \"count\": bucket.count, \"min\": bucket.minimum,\r\n            \"max\": bucket.maximum, \"mean\": bucket.mean}\r\n\u001b[?2004h\u001b[01;32magent@75b2a031766a\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[9.216977, "i", "printf '%s\\n' '--- alerts ---'; cat pipelinesense/alerts.py; printf '%s\\n' '--- archive ---'; cat pipelinesense/archive.py; printf '%s\\n' '--- pipeline ---'; cat pipelinesense/pipeline.py\n"]
[9.218563, "o", "printf '%s\\n' '--- alerts ---'; cat pipelinesense/alerts.py; printf '%s\\n' '--- archive ---'; cat pipelinesense/archive.py; printf '%s\\n' '--- pipeline ---'; cat pipelinesense/pipeline.py\r\n\u001b[?2004l\r--- alerts ---\r\n"]
[9.218694, "o", "\"\"\"Threshold alerts over interval buckets.\"\"\"\r\nfrom . import aggregate as agg\r\nfrom . import timeutil\r\n\r\n\r\ndef evaluate_alerts(readings, thresholds, interval=\"1h\"):\r\n    seconds = timeutil.interval_seconds(interval)\r\n    alerts = []\r\n    for bucket in agg.aggregate(readings, interval):\r\n        threshold = thresholds.get(bucket.sensor)\r\n        if threshold is None or bucket.maximum <= threshold:\r\n            continue\r\n        trigger = None\r\n        for r in readings:\r\n            if r.sensor != bucket.sensor or r.value <= threshold:\r\n                continue\r\n            if timeutil.bucket_start(r.timestamp, seconds).isoformat() != bucket.start:\r\n                continue\r\n            if trigger is None or r.timestamp < trigger.timestamp:\r\n                trigger = r\r\n        alerts.append({\"sensor\": bucket.sensor,\r\n                       \"bucket_start\": bucket.start,\r\n                       \"threshold\": threshold,\r\n                       \"triggered_at\": trigger.timestamp.isoformat(),\r\n                      "]
[9.218708, "o", " \"value\": trigger.value})\r\n    alerts.sort(key=lambda a: (a[\"sensor\"], a[\"bucket_start\"]))\r\n    return alerts\r\n"]
[9.219194, "o", "--- archive ---\r\n"]
[9.221515, "o", "\"\"\"Archive snapshots and consistency verification.\"\"\"\r\nimport json\r\nimport os\r\nimport sys\r\n\r\nfrom . import aggregate as agg\r\nfrom . import model\r\nfrom . import store\r\n\r\n\r\ndef snapshot(readings, out_dir, source_name, interval=\"1h\"):\r\n    os.makedirs(out_dir, exist_ok=True)\r\n    store.dump_readings(readings, os.path.join(out_dir, \"raw.json\"))\r\n    buckets = agg.aggregate(readings, interval)\r\n    with open(os.path.join(out_dir, \"aggregates.json\"), \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump([agg.bucket_to_dict(b) for b in buckets], fh, indent=2)\r\n        fh.write(\"\\n\")\r\n    meta = {\"source\": source_name, \"interval\": interval,\r\n            \"readings\": len(readings)}\r\n    with open(os.path.join(out_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump(meta, fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef verify(input_path, out_dir, interval=\"1h\"):\r\n    problems = []\r\n    fresh = store.load_readings(input_path)\r\n    try:\r\n        archived = store.load_readings(os.path.join(out_dir, \"raw.json\"))\r\n "]
[9.221825, "o", "   except OSError:\r\n        print(\"error: raw.json missing from archive\", file=sys.stderr)\r\n        return 1\r\n    if [model.to_dict(r) for r in archived] != [model.to_dict(r) for r in fresh]:\r\n        problems.append(\"raw section does not match source\")\r\n    with open(os.path.join(out_dir, \"aggregates.json\"), \"r\", encoding=\"utf-8\") as fh:\r\n        archived_buckets = json.load(fh)\r\n    expected_buckets = [agg.bucket_to_dict(b) for b in agg.aggregate(fresh, interval)]\r\n    if archived_buckets != expected_buckets:\r\n        problems.append(\"aggregate section does not match recomputation\")\r\n    if problems:\r\n        for problem in problems:\r\n            print(\"error: %s\" % problem, file=sys.stderr)\r\n        return 1\r\n    print(\"OK: archive matches source\")\r\n    return 0\r\n"]
[9.222365, "o", "--- pipeline ---\r\n"]
[9.224628, "o", "\"\"\"End-to-end pipeline over a single input file.\"\"\"\r\nimport json\r\nimport os\r\n\r\nfrom . import alerts as alerts_mod\r\nfrom . import archive\r\nfrom . import coverage\r\nfrom . import exporter\r\nfrom . import report\r\nfrom . import store\r\nfrom . import totals as totals_mod\r\n\r\n\r\ndef _write_json(path, doc):\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump(doc, fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef run_pipeline(input_path, out_dir, thresholds_path, interval=\"1h\"):\r\n    os.makedirs(out_dir, exist_ok=True)\r\n    readings = store.load_readings(input_path)\r\n    thresholds = store.load_thresholds(thresholds_path) if thresholds_path else {}\r\n\r\n    _write_json(os.path.join(out_dir, \"report.json\"),\r\n                report.build_report(readings, interval))\r\n    _write_json(os.path.join(out_dir, \"alerts.json\"),\r\n                alerts_mod.evaluate_alerts(readings, thresholds, interval))\r\n    _write_json(os.path.join(out_dir, \"totals.json\"),\r\n                totals_mod.daily_totals(readings))\r\n    _write"]
[9.22493, "o", "_json(os.path.join(out_dir, \"coverage.json\"),\r\n                coverage.coverage_gaps(readings, interval))\r\n    exporter.export_csv(readings, os.path.join(out_dir, \"readings.csv\"))\r\n    archive.snapshot(readings, out_dir, os.path.basename(input_path), interval)\r\n    return {\"readings\": len(readings)}\r\n\u001b[?2004h"]
[9.225264, "o", "\u001b[01;32magent@75b2a031766a\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[9.610031, "i", "printf '%s\\n' '--- store ---'; cat pipelinesense/store.py; printf '%s\\n' '--- exporter ---'; cat pipelinesense/exporter.py; printf '%s\\n' '--- cli ---'; cat pipelinesense/cli.py\n"]
[9.610911, "o", "printf '%s\\n' '--- store ---'; cat pipelinesense/store.py; printf '%s\\n' '--- exporter ---'; cat pipelinesense/exporter.py; printf '%s\\n' '--- cli ---'; cat pipelinesense/cli.py\r\n\u001b[?2004l\r--- store ---\r\n"]
[9.615056, "o", "\"\"\"Reading and threshold file access.\"\"\"\r\nimport json\r\n\r\nfrom . import model\r\n\r\n\r\ndef load_readings(path):\r\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n        payload = json.load(fh)\r\n    if not isinstance(payload, list):\r\n        raise model.ReadingError(\"input file must contain a JSON list of readings\")\r\n    return [model.from_dict(item) for item in payload]\r\n\r\n\r\ndef dump_readings(readings, path):\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump([model.to_dict(r) for r in readings], fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef load_thresholds(path):\r\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n        payload = json.load(fh)\r\n    if not isinstance(payload, dict):\r\n        raise model.ReadingError(\"thresholds file must contain a JSON object\")\r\n    return {str(key): float(value) for key, value in payload.items()}\r\n"]
[9.61521, "o", "--- exporter ---\r\n"]
[9.61799, "o", "\"\"\"CSV export of raw readings.\"\"\"\r\n\r\n\r\ndef export_csv(readings, path):\r\n    lines = [\"sensor,timestamp,value\"]\r\n    for r in readings:\r\n        lines.append(\"%s,%s,%s\" % (r.sensor, r.timestamp.isoformat(),\r\n                                    format_value(r.value)))\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        fh.write(\"\\n\".join(lines) + \"\\n\")\r\n\r\n\r\ndef format_value(value):\r\n    return str(value)\r\n"]
[9.621396, "o", "--- cli ---\r\n"]
[9.62302, "o", "\"\"\"Command line interface for the pipelinesense toolkit.\"\"\"\r\nimport argparse\r\nimport json\r\nimport os\r\nimport sys\r\n\r\nfrom . import alerts as alerts_mod\r\nfrom . import archive\r\nfrom . import coverage\r\nfrom . import exporter\r\nfrom . import model\r\nfrom . import pipeline as pipeline_mod\r\nfrom . import report\r\nfrom . import store\r\nfrom . import totals as totals_mod\r\n\r\n\r\ndef _print_json(doc):\r\n    print(json.dumps(doc, indent=2))\r\n\r\n\r\ndef build_parser():\r\n    parser = argparse.ArgumentParser(\r\n        prog=\"pipelinesense\",\r\n        description=\"Batch telemetry pipeline toolkit for sensor reading files\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    p = sub.add_parser(\"report\", help=\"aggregate report document\")\r\n    p.add_argument(\"--input\", required=True)\r\n    p.add_argument(\"--interval\", default=\"1h\")\r\n\r\n    p = sub.add_parser(\"alerts\", help=\"threshold alerts\")\r\n    p.add_argument(\"--input\", required=True)\r\n    p.add_argument(\"--thresholds\", default=\"data/thresholds.json\")\r\n    p.add_argume"]
[9.623627, "o", "nt(\"--interval\", default=\"1h\")\r\n\r\n    p = sub.add_parser(\"totals\", help=\"daily totals with cumulative sums\")\r\n    p.add_argument(\"--input\", required=True)\r\n\r\n    p = sub.add_parser(\"coverage\", help=\"bucket coverage report\")\r\n    p.add_argument(\"--input\", required=True)\r\n    p.add_argument(\"--interval\", default=\"1h\")\r\n\r\n    p = sub.add_parser(\"export\", help=\"CSV export of the raw readings\")\r\n    p.add_argument(\"--input\", required=True)\r\n    p.add_argument(\"--out\", required=True)\r\n\r\n    p = sub.add_parser(\"snapshot\", help=\"archive raw and aggregated data\")\r\n    p.add_argument(\"--input\", required=True)\r\n    p.add_argument(\"--dir\", required=True)\r\n    p.add_argument(\"--interval\", default=\"1h\")\r\n\r\n    p = sub.add_parser(\"verify\", help=\"check an archive against its source\")\r\n    p.add_argument(\"--input\", required=True)\r\n    p.add_argument(\"--dir\", required=True)\r\n    p.add_argument(\"--interval\", default=\"1h\")\r\n\r\n    p = sub.add_parser(\"pipeline\", help=\"run every stage over one input\")\r\n    p.add_argument(\"--input\","]
[9.63109, "o", " required=True)\r\n    p.add_argument(\"--dir\", required=True)\r\n    p.add_argument(\"--thresholds\", default=\"data/thresholds.json\")\r\n    p.add_argument(\"--interval\", default=\"1h\")\r\n\r\n    return parser\r\n\r\n\r\ndef main(argv=None):\r\n    args = build_parser().parse_args(argv)\r\n    try:\r\n        if args.command == \"report\":\r\n            readings = store.load_readings(args.input)\r\n            _print_json(report.build_report(readings, args.interval))\r\n            return 0\r\n        if args.command == \"alerts\":\r\n            readings = store.load_readings(args.input)\r\n            thresholds = store.load_thresholds(args.thresholds)\r\n            _print_json(alerts_mod.evaluate_alerts(readings, thresholds, args.interval))\r\n            return 0\r\n        if args.command == \"totals\":\r\n            _print_json(totals_mod.daily_totals(store.load_readings(args.input)))\r\n            return 0\r\n        if args.command == \"coverage\":\r\n            _print_json(coverage.coverage_gaps(store.load_readings(args.input),\r\n                        "]
[9.631571, "o", "                       args.interval))\r\n            return 0\r\n        if args.command == \"export\":\r\n            exporter.export_csv(store.load_readings(args.input), args.out)\r\n            return 0\r\n        if args.command == \"snapshot\":\r\n            archive.snapshot(store.load_readings(args.input), args.dir,\r\n                             os.path.basename(args.input), args.interval)\r\n            return 0\r\n        if args.command == \"verify\":\r\n            return archive.verify(args.input, args.dir, args.interval)\r\n        if args.command == \"pipeline\":\r\n            result = pipeline_mod.run_pipeline(args.input, args.dir,\r\n                                               args.thresholds, args.interval)\r\n            _print_json(result)\r\n            return 0\r\n    except (OSError, model.ReadingError, ValueError) as exc:\r\n        print(\"error: %s\" % exc, file=sys.stderr)\r\n        return 2\r\n    return 2\r\n\u001b[?2004h\u001b[01;32magent@75b2a031766a\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[9.852389, "i", "printf '%s\\n' '--- report ---'; cat pipelinesense/report.py; printf '%s\\n' '--- totals ---'; cat pipelinesense/totals.py; printf '%s\\n' '--- coverage ---'; cat pipelinesense/coverage.py; printf '%s\\n' '--- README ---'; cat README.md; printf '%s\\n' '--- pyproject ---'; cat pyproject.toml\n"]
[9.853944, "o", "printf '%s\\n' '--- report ---'; cat pipelinesense/report.py; printf '%s\\n' '--- totals ---'; cat pipelinesense/totals.py; printf '%s\\n' '--- coverage ---'; cat pipelinesense/coverage.py; printf '%s\\n' '--- README ---'; cat README.md; printf '%s\\n' '--- pyproject ---'; cat pyproject.toml\r\n\u001b[?2004l\r--- report ---\r\n"]
[9.856906, "o", "\"\"\"Aggregated report document.\"\"\"\r\nfrom . import aggregate as agg\r\n\r\n\r\ndef build_report(readings, interval=\"1h\"):\r\n    daily = agg.aggregate(readings, \"1d\")\r\n    hourly = agg.aggregate(readings, interval)\r\n    return {\r\n        \"summary\": [agg.bucket_to_dict(b) for b in daily],\r\n        \"hourly\": [agg.bucket_to_dict(b) for b in hourly],\r\n    }\r\n"]
[9.858899, "o", "--- totals ---\r\n"]
[9.863354, "o", "\"\"\"Per-sensor daily totals with a running cumulative sum.\"\"\"\r\nfrom . import aggregate as agg\r\n\r\n\r\ndef daily_totals(readings):\r\n    agg.aggregate(readings, \"1d\")\r\n    rows = []\r\n    index = {}\r\n    for r in readings:\r\n        day = r.timestamp.date().isoformat()\r\n        key = (r.sensor, day)\r\n        if key not in index:\r\n            row = {\"sensor\": r.sensor, \"day\": day, \"samples\": 0,\r\n                   \"daily_sum\": 0.0, \"cumulative\": 0.0}\r\n            index[key] = row\r\n            rows.append(row)\r\n        index[key][\"samples\"] += 1\r\n        index[key][\"daily_sum\"] += r.value\r\n    cumulative = {}\r\n    for row in rows:\r\n        cumulative[row[\"sensor\"]] = cumulative.get(row[\"sensor\"], 0.0) + row[\"daily_sum\"]\r\n        row[\"cumulative\"] = cumulative[row[\"sensor\"]]\r\n    return rows\r\n"]
[9.863551, "o", "--- coverage ---\r\n"]
[9.867274, "o", "\"\"\"Bucket coverage report.\"\"\"\r\nfrom datetime import datetime, timedelta\r\n\r\nfrom . import aggregate as agg\r\nfrom . import timeutil\r\n\r\n\r\ndef coverage_gaps(readings, interval=\"1h\"):\r\n    seconds = timeutil.interval_seconds(interval)\r\n    grouped = {}\r\n    for bucket in agg.aggregate(readings, interval):\r\n        grouped.setdefault(bucket.sensor, []).append(bucket)\r\n    reports = []\r\n    for sensor in sorted(grouped):\r\n        buckets = grouped[sensor]\r\n        first = datetime.fromisoformat(buckets[0].start)\r\n        last = datetime.fromisoformat(buckets[-1].start)\r\n        present = {b.start for b in buckets}\r\n        missing = []\r\n        cursor = first\r\n        while cursor <= last:\r\n            if cursor.isoformat() not in present:\r\n                missing.append(cursor.isoformat())\r\n            cursor = cursor + timedelta(seconds=seconds)\r\n        reports.append({\"sensor\": sensor,\r\n                        \"first\": first.isoformat(),\r\n                        \"last\": last.isoformat(),\r\n                       "]
[9.867336, "o", " \"expected\": len(present) + len(missing),\r\n                        \"present\": len(present),\r\n                        \"missing\": missing})\r\n    return reports\r\n"]
[9.869384, "o", "--- README ---\r\n"]
[9.871864, "o", "# Pipelinesense\r\n\r\nA small, dependency-free toolkit for batch telemetry pipelines. It reads JSON\r\nfiles of sensor readings and produces aggregate reports, threshold alerts,\r\ndaily totals, coverage reports, CSV exports and archive snapshots.\r\n\r\n## Usage\r\n\r\nRun from the repository root:\r\n\r\n    python3 -m pipelinesense report --input data/day1.json\r\n    python3 -m pipelinesense alerts --input data/day1.json --thresholds data/thresholds.json\r\n    python3 -m pipelinesense totals --input data/day1.json\r\n    python3 -m pipelinesense coverage --input data/day1.json --interval 15m\r\n    python3 -m pipelinesense export --input data/day1.json --out readings.csv\r\n    python3 -m pipelinesense snapshot --input data/day1.json --dir /tmp/archive\r\n    python3 -m pipelinesense verify --input data/day1.json --dir /tmp/archive\r\n    python3 -m pipelinesense pipeline --input data/day1.json --dir /tmp/out --thresholds data/thresholds.json\r\n\r\n## Input format\r\n\r\nA reading file is a JSON list of objects:\r\n\r\n    {\"sensor\": \"temp-1\", \"ti"]
[9.871892, "o", "mestamp\": \"2024-05-01T09:52:03\", \"value\": 34.2}\r\n\r\nReadings are stored in arrival order: sensors are interleaved and files may\r\nend with late-arriving samples, so never assume a reading file is sorted.\r\n"]
[9.873254, "o", "--- pyproject ---\r\n"]
[9.87485, "o", "[project]\r\nname = \"pipelinesense\"\r\nversion = \"0.4.1\"\r\ndescription = \"Small telemetry reading pipeline toolkit\"\r\nrequires-python = \">=3.10\"\r\n"]
