[15.487308, "o", "\"\"\"End-to-end pipeline over a single input file.\"\"\"\r\nimport json\r\nimport os\r\n\r\nfrom . import alerts as alerts_mod\r\nfrom . import archive\r\nfrom . import coverage\r\nfrom . import exporter\r\nfrom . import report\r\nfrom . import store\r\nfrom . import totals as totals_mod\r\n\r\n\r\ndef _write_json(path, doc):\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump(doc, fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef run_pipeline(input_path, out_dir, thresholds_path, interval=\"1h\"):\r\n    os.makedirs(out_dir, exist_ok=True)\r\n    readings = store.load_readings(input_path)\r\n    thresholds = store.load_thresholds(thresholds_path) if thresholds_path else {}\r\n\r\n    _write_json(os.path.join(out_dir, \"report.json\"),\r\n                report.build_report(readings, interval))\r\n    _write_json(os.path.join(out_dir, \"alerts.json\"),\r\n                alerts_mod.evaluate_alerts(readings, thresholds, interval))\r\n    _write_json(os.path.join(out_dir, \"totals.json\"),\r\n                totals_mod.daily_totals(readings))\r\n    _write"]
[15.487657, "o", "_json(os.path.join(out_dir, \"coverage.json\"),\r\n                coverage.coverage_gaps(readings, interval))\r\n    exporter.export_csv(readings, os.path.join(out_dir, \"readings.csv\"))\r\n    archive.snapshot(readings, out_dir, os.path.basename(input_path), interval)\r\n    return {\"readings\": len(readings)}\r\n"]
[15.49005, "o", "\u001b[?2004h\u001b[01;32magent@75b2a031766a\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[15.957309, "i", "sed -n '1,220p' pipelinesense/store.py; printf '\\n--- exporter ---\\n'; sed -n '1,160p' pipelinesense/exporter.py\n"]
[15.960614, "o", "sed -n '1,220p' pipelinesense/store.py; printf '\\n--- exporter ---\\n'; sed -n '1,160p' pipelinesense/exporter.py\r\n\u001b[?2004l\r"]
[15.975015, "o", "\"\"\"Reading and threshold file access.\"\"\"\r\nimport json\r\n\r\nfrom . import model\r\n\r\n\r\ndef load_readings(path):\r\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n        payload = json.load(fh)\r\n    if not isinstance(payload, list):\r\n        raise model.ReadingError(\"input file must contain a JSON list of readings\")\r\n"]
[15.992575, "o", "    return [model.from_dict(item) for item in payload]\r\n\r\n\r\ndef dump_readings(readings, path):\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump([model.to_dict(r) for r in readings], fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef load_thresholds(path):\r\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n        payload = json.load(fh)\r\n    if not isinstance(payload, dict):\r\n        raise model.ReadingError(\"thresholds file must contain a JSON object\")\r\n    return {str(key): float(value) for key, value in payload.items()}\r\n\r\n--- exporter ---\r\n"]
[15.997033, "o", "\"\"\"CSV export of raw readings.\"\"\"\r\n\r\n\r\ndef export_csv(readings, path):\r\n    lines = [\"sensor,timestamp,value\"]\r\n    for r in readings:\r\n        lines.append(\"%s,%s,%s\" % (r.sensor, r.timestamp.isoformat(),\r\n                                    format_value(r.value)))\r\n"]
[15.997874, "o", "    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        fh.write(\"\\n\".join(lines) + \"\\n\")\r\n\r\n\r\ndef format_value(value):\r\n    return str(value)\r\n"]
[15.99826, "o", "\u001b[?2004h\u001b[01;32magent@75b2a031766a\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
