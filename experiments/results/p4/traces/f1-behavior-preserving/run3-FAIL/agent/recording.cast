[15.346263, "o", "\"\"\"Archive snapshots and consistency verification.\"\"\"\r\nimport json\r\nimport os\r\nimport sys\r\n\r\nfrom . import aggregate as agg\r\nfrom . import model\r\nfrom . import store\r\n\r\n\r\ndef snapshot(readings, out_dir, source_name, interval=\"1h\"):\r\n    os.makedirs(out_dir, exist_ok=True)\r\n    store.dump_readings(readings, os.path.join(out_dir, \"raw.json\"))\r\n    buckets = agg.aggregate(readings, interval)\r\n    with open(os.path.join(out_dir, \"aggregates.json\"), \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump([agg.bucket_to_dict(b) for b in buckets], fh, indent=2)\r\n        fh.write(\"\\n\")\r\n    meta = {\"source\": source_name, \"interval\": interval,\r\n            \"readings\": len(readings)}\r\n    with open(os.path.join(out_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump(meta, fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef verify(input_path, out_dir, interval=\"1h\"):\r\n    problems = []\r\n    fresh = store.load_readings(input_path)\r\n    try:\r\n        archived = store.load_readings(os.path.join(out_dir, \"raw.json\"))\r\n "]
[15.346748, "o", "   except OSError:\r\n        print(\"error: raw.json missing from archive\", file=sys.stderr)\r\n        return 1\r\n    if [model.to_dict(r) for r in archived] != [model.to_dict(r) for r in fresh]:\r\n        problems.append(\"raw section does not match source\")\r\n    with open(os.path.join(out_dir, \"aggregates.json\"), \"r\", encoding=\"utf-8\") as fh:\r\n        archived_buckets = json.load(fh)\r\n    expected_buckets = [agg.bucket_to_dict(b) for b in agg.aggregate(fresh, interval)]\r\n    if archived_buckets != expected_buckets:\r\n        problems.append(\"aggregate section does not match recomputation\")\r\n    if problems:\r\n        for problem in problems:\r\n            print(\"error: %s\" % problem, file=sys.stderr)\r\n        return 1\r\n    print(\"OK: archive matches source\")\r\n    return 0\r\n\r\n===== README =====\r\n"]
[15.351191, "o", "# Pipelinesense\r\n\r\nA small, dependency-free toolkit for batch telemetry pipelines. It reads JSON\r\nfiles of sensor readings and produces aggregate reports, threshold alerts,\r\ndaily totals, coverage reports, CSV exports and archive snapshots.\r\n\r\n## Usage\r\n\r\nRun from the repository root:\r\n\r\n    python3 -m pipelinesense report --input data/day1.json\r\n    python3 -m pipelinesense alerts --input data/day1.json --thresholds data/thresholds.json\r\n    python3 -m pipelinesense totals --input data/day1.json\r\n    python3 -m pipelinesense coverage --input data/day1.json --interval 15m\r\n    python3 -m pipelinesense export --input data/day1.json --out readings.csv\r\n    python3 -m pipelinesense snapshot --input data/day1.json --dir /tmp/archive\r\n    python3 -m pipelinesense verify --input data/day1.json --dir /tmp/archive\r\n    python3 -m pipelinesense pipeline --input data/day1.json --dir /tmp/out --thresholds data/thresholds.json\r\n\r\n## Input format\r\n\r\nA reading file is a JSON list of objects:\r\n\r\n    {\"sensor\": \"temp-1\", \"ti"]
[15.351243, "o", "mestamp\": \"2024-05-01T09:52:03\", \"value\": 34.2}\r\n\r\nReadings are stored in arrival order: sensors are interleaved and files may\r\nend with late-arriving samples, so never assume a reading file is sorted.\r\n\r\n"]
[15.351488, "o", "===== pyproject =====\r\n"]
