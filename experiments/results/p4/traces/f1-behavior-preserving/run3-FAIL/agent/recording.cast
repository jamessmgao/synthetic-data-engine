[16.464069, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('pipelinesense/aggregate.py')\ntext = path.read_text()\ntext = text.replace('from dataclasses import dataclass\\n', 'from dataclasses import dataclass, replace\\n')\ntext = text.replace('    seconds = timeutil.interval_seconds(interval)\\n    for r in readings:\\n        r.timestamp = timeutil.bucket_start(r.timestamp, seconds)\\n    readings.sort(key=lambda r: (r.sensor, r.timestamp))\\n', '    seconds = timeutil.interval_seconds(interval)\\n    # Aggregate a copy so callers retain their input order and original\\n    # timestamps.  Stages in the pipeline intentionally share one list.\\n    readings = [replace(r) for r in readings]\\n    for r in readings:\\n        r.timestamp = timeutil.bucket_start(r.timestamp, seconds)\\n    readings.sort(key=lambda r: (r.sensor, r.timestamp))\\n')\npath.write_text(text)\nPY\nsed -n '1,100p' pipelinesense/aggregate.py\n"]
[16.464242, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[16.464303, "o", "\u001b[?2004h> "]
[16.464329, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.464526, "o", "path = Path('pipelinesense/aggregate.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.465694, "o", "text = path.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> text = text.replace('from dataclasses import dataclass\\n', 'from dataclasses import dataclass, replace\\n')\r\n\u001b[?2004l\r\u001b[?2004h> text = text.replace('    seconds = timeutil.interval_seconds(interval)\\n    for r in readings:\\n        r.timestamp = timeutil.bucket_start(r.timestamp, seconds)\\n    readings.sort(key=lambda r: (r.sensor, r.timestamp))\\n', '    seconds = timeutil.interval_seconds(interval)\\n    # Aggregate a copy so callers retain their input order and original\\n    # timestamps.  Stages in the pipeline intentionally share one list.\\n    readings = [replace(r) for r in readings]\\n    for r in readings:\\n        r.timestamp = timeutil.bucket_start(r.timestamp, seconds)\\n    readings.sort(key=lambda r: (r.sensor, r.timestamp))\\n')\r\n\u001b[?2004l\r\u001b[?2004h> path.write_text(text)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[16.494701, "o", "\u001b[?2004h\u001b[01;32magent@0bc54e53e0e2\u001b[00m:\u001b[01;34m/app\u001b[00m$ sed -n '1,100p' pipelinesense/aggregate.py\r\n\u001b[?2004l\r"]
[16.495942, "o", "\"\"\"Fixed-interval bucket aggregation over readings.\"\"\"\r\nfrom dataclasses import dataclass, replace\r\n\r\nfrom . import timeutil\r\n\r\n\r\n@dataclass\r\nclass Bucket:\r\n    sensor: str\r\n    start: str\r\n    count: int\r\n    minimum: float\r\n    maximum: float\r\n    mean: float\r\n\r\n\r\ndef aggregate(readings, interval=\"1h\"):\r\n    seconds = timeutil.interval_seconds(interval)\r\n    # Aggregate a copy so callers retain their input order and original\r\n    # timestamps.  Stages in the pipeline intentionally share one list.\r\n    readings = [replace(r) for r in readings]\r\n    for r in readings:\r\n        r.timestamp = timeutil.bucket_start(r.timestamp, seconds)\r\n    readings.sort(key=lambda r: (r.sensor, r.timestamp))\r\n    grouped = {}\r\n    for r in readings:\r\n        grouped.setdefault((r.sensor, r.timestamp), []).append(r.value)\r\n    buckets = []\r\n    for (sensor, start), values in grouped.items():\r\n        buckets.append(Bucket(sensor=sensor, start=start.isoformat(),\r\n                              count=len(values), minimum=min(value"]
[16.495961, "o", "s),\r\n                              maximum=max(values),\r\n                              mean=sum(values) / len(values)))\r\n    buckets.sort(key=lambda b: (b.sensor, b.start))\r\n    return buckets\r\n\r\n\r\ndef bucket_to_dict(bucket):\r\n    return {\"sensor\": bucket.sensor, \"start\": bucket.start,\r\n            \"count\": bucket.count, \"min\": bucket.minimum,\r\n            \"max\": bucket.maximum, \"mean\": bucket.mean}\r\n"]
