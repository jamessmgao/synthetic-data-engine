[54.78885, "i", "rm -rf /tmp/standalone && mkdir -p /tmp/standalone && python3 -m pipelinesense report --input data/day1.json > /tmp/standalone/report.json && python3 -m pipelinesense alerts --input data/day1.json --thresholds data/thresholds.json > /tmp/standalone/alerts.json && python3 -m pipelinesense totals --input data/day1.json > /tmp/standalone/totals.json && python3 -m pipelinesense coverage --input data/day1.json > /tmp/standalone/coverage.json && python3 -m pipelinesense export --input data/day1.json --out /tmp/standalone/readings.csv && python3 -m pipelinesense snapshot --input data/day1.json --dir /tmp/standalone && for name in report.json alerts.json totals.json coverage.json readings.csv raw.json aggregates.json meta.json; do cmp -s \"/tmp/standalone/$name\" \"/tmp/out/$name\" && echo \"OK $name\" || { echo \"DIFF $name\"; diff -u \"/tmp/standalone/$name\" \"/tmp/out/$name\"; }; done\n"]
