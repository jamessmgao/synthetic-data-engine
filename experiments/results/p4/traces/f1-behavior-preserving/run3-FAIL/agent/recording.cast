[47.457309, "o", "\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> source = json.loads(Path('data/day1.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> raw = json.loads(Path('/tmp/out/raw.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> assert raw == source\r\n\u001b[?2004l\r\u001b[?2004h> assert [r['timestamp'] for r in raw] == [r['timestamp'] for r in source]\r\n\u001b[?2004l\r\u001b[?2004h> report = json.loads(Path('/tmp/out/report.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> assert report['summary'] and report['hourly']\r\n\u001b[?2004l\r\u001b[?2004h> print('VALIDATION OK')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[47.519268, "o", "VALIDATION OK\r\n"]
