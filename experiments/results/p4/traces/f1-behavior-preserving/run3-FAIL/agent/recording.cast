[9.288802, "o", "\"\"\"Reading record model.\"\"\"\r\nfrom dataclasses import dataclass\r\nfrom datetime import datetime\r\n\r\n\r\nclass ReadingError(ValueError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass Reading:\r\n    sensor: str\r\n    timestamp: datetime\r\n    value: float\r\n\r\n\r\ndef from_dict(payload):\r\n    if not isinstance(payload, dict):\r\n        raise ReadingError(\"reading must be a JSON object\")\r\n    try:\r\n        return Reading(sensor=str(payload[\"sensor\"]),\r\n                       timestamp=datetime.fromisoformat(str(payload[\"timestamp\"])),\r\n                       value=float(payload[\"value\"]))\r\n    except KeyError as exc:\r\n        raise ReadingError(\"missing field: %s\" % exc) from None\r\n\r\n\r\ndef to_dict(reading):\r\n    return {\"sensor\": reading.sensor,\r\n            \"timestamp\": reading.timestamp.isoformat(),\r\n            \"value\": reading.value}\r\n"]
[9.289419, "o", "===== pipelinesense/store.py =====\r\n"]
[9.290895, "o", "\"\"\"Reading and threshold file access.\"\"\"\r\nimport json\r\n\r\nfrom . import model\r\n\r\n\r\ndef load_readings(path):\r\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n        payload = json.load(fh)\r\n    if not isinstance(payload, list):\r\n        raise model.ReadingError(\"input file must contain a JSON list of readings\")\r\n    return [model.from_dict(item) for item in payload]\r\n\r\n\r\ndef dump_readings(readings, path):\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump([model.to_dict(r) for r in readings], fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef load_thresholds(path):\r\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n        payload = json.load(fh)\r\n    if not isinstance(payload, dict):\r\n        raise model.ReadingError(\"thresholds file must contain a JSON object\")\r\n    return {str(key): float(value) for key, value in payload.items()}\r\n===== pipelinesense/report.py =====\r\n"]
[9.292547, "o", "\"\"\"Aggregated report document.\"\"\"\r\nfrom . import aggregate as agg\r\n\r\n\r\ndef build_report(readings, interval=\"1h\"):\r\n    daily = agg.aggregate(readings, \"1d\")\r\n    hourly = agg.aggregate(readings, interval)\r\n    return {\r\n        \"summary\": [agg.bucket_to_dict(b) for b in daily],\r\n        \"hourly\": [agg.bucket_to_dict(b) for b in hourly],\r\n    }\r\n"]
[9.292727, "o", "===== pipelinesense/pipeline.py =====\r\n"]
[9.293353, "o", "\"\"\"End-to-end pipeline over a single input file.\"\"\"\r\nimport json\r\nimport os\r\n\r\nfrom . import alerts as alerts_mod\r\nfrom . import archive\r\nfrom . import coverage\r\nfrom . import exporter\r\nfrom . import report\r\nfrom . import store\r\nfrom . import totals as totals_mod\r\n\r\n\r\ndef _write_json(path, doc):\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump(doc, fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef run_pipeline(input_path, out_dir, thresholds_path, interval=\"1h\"):\r\n    os.makedirs(out_dir, exist_ok=True)\r\n    readings = store.load_readings(input_path)\r\n    thresholds = store.load_thresholds(thresholds_path) if thresholds_path else {}\r\n\r\n    _write_json(os.path.join(out_dir, \"report.json\"),\r\n                report.build_report(readings, interval))\r\n    _write_json(os.path.join(out_dir, \"alerts.json\"),\r\n                alerts_mod.evaluate_alerts(readings, thresholds, interval))\r\n    _write_json(os.path.join(out_dir, \"totals.json\"),\r\n                totals_mod.daily_totals(readings))\r\n    _write"]
[9.293393, "o", "_json(os.path.join(out_dir, \"coverage.json\"),\r\n                coverage.coverage_gaps(readings, interval))\r\n    exporter.export_csv(readings, os.path.join(out_dir, \"readings.csv\"))\r\n    archive.snapshot(readings, out_dir, os.path.basename(input_path), interval)\r\n    return {\"readings\": len(readings)}\r\n"]
[9.293594, "o", "===== pipelinesense/archive.py =====\r\n"]
[9.294137, "o", "\"\"\"Archive snapshots and consistency verification.\"\"\"\r\nimport json\r\nimport os\r\nimport sys\r\n\r\nfrom . import aggregate as agg\r\nfrom . import model\r\nfrom . import store\r\n\r\n\r\ndef snapshot(readings, out_dir, source_name, interval=\"1h\"):\r\n    os.makedirs(out_dir, exist_ok=True)\r\n    store.dump_readings(readings, os.path.join(out_dir, \"raw.json\"))\r\n    buckets = agg.aggregate(readings, interval)\r\n    with open(os.path.join(out_dir, \"aggregates.json\"), \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump([agg.bucket_to_dict(b) for b in buckets], fh, indent=2)\r\n        fh.write(\"\\n\")\r\n    meta = {\"source\": source_name, \"interval\": interval,\r\n            \"readings\": len(readings)}\r\n    with open(os.path.join(out_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as fh:\r\n        json.dump(meta, fh, indent=2)\r\n        fh.write(\"\\n\")\r\n\r\n\r\ndef verify(input_path, out_dir, interval=\"1h\"):\r\n    problems = []\r\n    fresh = store.load_readings(input_path)\r\n    try:\r\n        archived = store.load_readings(os.path.join(out_dir, \"raw.json\"))\r\n "]
[9.294151, "o", "   except OSError:\r\n        print(\"error: raw.json missing from archive\", file=sys.stderr)\r\n        return 1\r\n    if [model.to_dict(r) for r in archived] != [model.to_dict(r) for r in fresh]:\r\n        problems.append(\"raw section does not match source\")\r\n    with open(os.path.join(out_dir, \"aggregates.json\"), \"r\", encoding=\"utf-8\") as fh:\r\n        archived_buckets = json.load(fh)\r\n    expected_buckets = [agg.bucket_to_dict(b) for b in agg.aggregate(fresh, interval)]\r\n    if archived_buckets != expected_buckets:\r\n        problems.append(\"aggregate section does not match recomputation\")\r\n    if problems:\r\n        for problem in problems:\r\n            print(\"error: %s\" % problem, file=sys.stderr)\r\n        return 1\r\n    print(\"OK: archive matches source\")\r\n    return 0\r\n"]
[9.294351, "o", "===== pipelinesense/exporter.py =====\r\n"]
[9.294955, "o", "\"\"\"CSV export of raw readings.\"\"\"\r\n\r\n\r\ndef export_csv(readings, path):\r\n    lines = [\"sensor,timestamp,value\"]\r\n    for r in readings:\r\n        lines.append(\"%s,%s,%s\" % (r.sensor, r.timestamp.isoformat(),\r\n                                    format_value(r.value)))\r\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\r\n        fh.write(\"\\n\".join(lines) + \"\\n\")\r\n\r\n\r\ndef format_value(value):\r\n    return str(value)\r\n"]
[9.295146, "o", "===== pipelinesense/totals.py =====\r\n"]
[9.295751, "o", "\"\"\"Per-sensor daily totals with a running cumulative sum.\"\"\"\r\nfrom . import aggregate as agg\r\n\r\n\r\ndef daily_totals(readings):\r\n    agg.aggregate(readings, \"1d\")\r\n    rows = []\r\n    index = {}\r\n    for r in readings:\r\n        day = r.timestamp.date().isoformat()\r\n        key = (r.sensor, day)\r\n        if key not in index:\r\n            row = {\"sensor\": r.sensor, \"day\": day, \"samples\": 0,\r\n                   \"daily_sum\": 0.0, \"cumulative\": 0.0}\r\n            index[key] = row\r\n            rows.append(row)\r\n        index[key][\"samples\"] += 1\r\n        index[key][\"daily_sum\"] += r.value\r\n    cumulative = {}\r\n    for row in rows:\r\n        cumulative[row[\"sensor\"]] = cumulative.get(row[\"sensor\"], 0.0) + row[\"daily_sum\"]\r\n        row[\"cumulative\"] = cumulative[row[\"sensor\"]]\r\n    return rows\r\n"]
[9.295896, "o", "===== pipelinesense/timeutil.py =====\r\n"]
[9.296371, "o", "\"\"\"Interval parsing and epoch-aligned bucketing helpers.\"\"\"\r\nimport re\r\nfrom datetime import datetime, timedelta\r\n\r\n_EPOCH = datetime(1970, 1, 1)\r\n_UNITS = {\"m\": 60, \"h\": 3600, \"d\": 86400}\r\n_PATTERN = re.compile(r\"^([1-9][0-9]*)([mhd])$\")\r\n\r\n\r\ndef interval_seconds(interval):\r\n    match = _PATTERN.match(str(interval))\r\n    if not match:\r\n        raise ValueError(\"invalid interval: %r\" % (interval,))\r\n    return int(match.group(1)) * _UNITS[match.group(2)]\r\n\r\n\r\ndef bucket_start(ts, seconds):\r\n    delta = ts - _EPOCH\r\n    offset = (delta // timedelta(seconds=seconds)) * seconds\r\n    return _EPOCH + timedelta(seconds=offset)\r\n"]
