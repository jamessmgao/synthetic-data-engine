# Copy to .env (git-ignored) and fill in. Harmless placeholders only.

# Inference gateway (generator and Harbor's LiteLLM both read these).
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://gateway.example.com/openrouter/api/v1

# Backends. Unset = local defaults: SQLite at work/sde.db, the jobs table as the
# queue, artifacts under work/. The compose stack sets these for its services.
# DATABASE_URL=postgresql://sde:sde@localhost:5432/sde
# REDIS_URL=redis://localhost:6379/0
# S3_BUCKET=sde-artifacts
# S3_ENDPOINT_URL=http://localhost:9000      # local S3 (compose); leave unset for AWS S3
# AWS_ACCESS_KEY_ID=sde-dev
# AWS_SECRET_ACCESS_KEY=sde-dev-secret
# SDE_WORK_DIR=./work

# Coordination (defaults shown).
# SDE_DOCKER_SLOTS=4
# SDE_LEASE_TTL_S=600
# SDE_HEARTBEAT_S=60
# SDE_RECONCILE_S=30

# Operator auth for the API.
# SDE_API_KEY=
